{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/template-parser",
    "types": ["node"],
    "sourceMap": true
  },
  "include": [
    "**/*.test.ts",
    "**/*_test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
